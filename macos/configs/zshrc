# If you come from bash you might have to change your $PATH.
export PATH="$HOME/Applications/platform-tools:$HOME/.bin:$HOME/.rvm/bin:$PATH"

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Oh-my-zsh settings
ZSH_THEME="robbyrussell"
DISABLE_UPDATE_PROMPT=true
plugins=(
  autoupdate
  git
  zsh-syntax-highlighting
  colored-man-pages
  zsh-autosuggestions
  macos
)
ZSH_DISABLE_COMPFIX=true
source $ZSH/oh-my-zsh.sh


# Other Exports
export PAGER="less -S" psql
export AWS_PAGER=''
export EDITOR='vim'

# Source system specific options
if [[ -d ${HOME}/.zshrc.d ]]; then
	for file (${HOME}/.zshrc.d/**/*.zsh(N.)) . $file
fi

# Autoload core functions
FPATH=~/.zsh_functions:$FPATH
autoload -Uz ${HOME}/.zsh_functions/*(.:t)

# Aliases
alias -s {yml,yaml}=vi
alias shred='gshred -n 7 -z -u'

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/dalton_rick/Applications/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/dalton_rick/Applications/google-cloud-sdk/path.zsh.inc'; fi
# The next line enables shell command completion for gcloud.
if [ -f '/Users/dalton_rick/Applications/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/dalton_rick/Applications/google-cloud-sdk/completion.zsh.inc'; fi

# Set options
set -o vi
unsetopt histverify
