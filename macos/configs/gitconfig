# This is Git's per-user configuration file.
[core]
	pager = less -F -X
	excludesfile = ~/.gitignore_global

[push]
	followTags = true
	default = current

[pull]
	rebase = true

[include]
	path = ~/.gitconfig-local

[includeIf "gitdir:~/Personal/"]
	path = ~/.gitconfig-personal

[includeIf "gitdir:~/Work/"]
	path = ~/.gitconfig-work

